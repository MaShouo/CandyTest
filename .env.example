# Deployment settings written and maintained by ./deploy.sh. The published image can
# be pinned to a release tag (for example ghcr.io/mashouo/candytest:v1.4.0).
CANDYTEST_IMAGE=ghcr.io/mashouo/candytest:latest
CANDYTEST_MODE=auto
# `auto` is only used on first deploy; a healthy deployment records host, npm, or caddy.
# Host mode is fixed to 127.0.0.1; external access must use a reverse proxy.
CANDYTEST_PORT=8765
CANDYTEST_MEMORY_LIMIT=2g
CANDYTEST_HEALTH_TIMEOUT=120

# For Nginx Proxy Manager mode, deploy.sh discovers and writes the existing
# Docker network. It never creates this network.
# NPM_NETWORK=npm_default

# Required only for: ./deploy.sh --mode caddy --domain example.com
# CANDYTEST_DOMAIN=example.com

# Fresh server volumes use the initial login admin / admin. Change it in
# Settings → 登录账号 immediately after signing in.
# The following legacy inputs are optional and are used only once to migrate a
# deployment that used environment credentials before auth.json existed.
ADMIN_USERNAME=
PASSWORD_HASH_B64=
SECRET_KEY=
COOKIE_SECURE=1
