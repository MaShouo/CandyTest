# Compose build/runtime versions (safe defaults)
PI_VERSION=0.84.2
CODEX_VERSION=0.147.0

# The Compose port mapping is fixed to host loopback.
CANDYTEST_PORT=8765
CANDYTEST_MEMORY_LIMIT=2g

# Server authentication. Fill every blank value before starting.
ADMIN_USERNAME=
# Generate the base64-encoded Werkzeug hash and random secret as documented.
PASSWORD_HASH_B64=
SECRET_KEY=
COOKIE_SECURE=1
