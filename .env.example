# Copy this file to .env and replace every placeholder before running Docker Compose.
# These values are intentionally not usable credentials.
GITHUB_OWNER=REPLACE_WITH_GITHUB_OWNER
CANDYTEST_VERSION=latest
CANDYTEST_DOMAIN=REPLACE_WITH_PUBLIC_DOMAIN
CADDY_ACME_EMAIL=REPLACE_WITH_ACME_EMAIL
CADDY_BASIC_AUTH_USER=REPLACE_WITH_BASIC_AUTH_USERNAME

# Generate interactively (never put the plaintext password in this file):
# docker run --rm -it caddy:2.8.4-alpine caddy hash-password
# Paste the generated bcrypt value as one single-quoted value. Bcrypt contains
# dollar signs; single quotes preserve them in a Compose .env file, e.g.:
# CADDY_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_GENERATED_BCRYPT_HASH'
# If placing a hash directly in compose.yaml instead, escape every $ as $$.
CADDY_BASIC_AUTH_HASH='REPLACE_WITH_GENERATED_BCRYPT_HASH'
